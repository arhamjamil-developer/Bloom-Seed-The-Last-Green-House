  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d1c72773f122cd245b37984f99acc0f1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Bloombots.StorybookView
  opening:
  - art: {fileID: 21300000, guid: 112d5b4648b81ff46b30c1b183c9cd4c, type: 3}
    title: The last greenhouse
    copy: The city gardens went quiet. One seed still glows in Eden-9.
  - art: {fileID: 21300000, guid: 0294784b5d24deb4a8dfb11d3a6996c1, type: 3}
    title: A seed that sings
    copy: Pip hears the Seed calling to four sleeping gardens. Wake the relays and
      water can return.
  - art: {fileID: 21300000, guid: cd1640ec82520c5489be4b6aa1ed3454, type: 3}
    title: Hold the line
    copy: Dubu and Arham step forward. Keep the Rust Bugs away from the Seed Core.
  map:
  - art: {fileID: 21300000, guid: 26287e6cbc9647828a588f620ba83b50, type: 3}
    title: 1. Dawn Nursery
    copy: Guard the Seed, move a hero to cover a second lane, and grow a connected
      garden.
  - art: {fileID: 21300000, guid: a9316d26cbd24852a227e9b089d8c7f5, type: 3}
    title: 2. Moonlit Canopy
    copy: Follow the dark waterway and wake the canopy lamps.
  - art: {fileID: 21300000, guid: 64135bae6a234f6cb6c265422d069bc5, type: 3}
    title: 3. Rustworks Gate
    copy: Follow the old pipes to Mother Rust's shutoff valve.
  - art: {fileID: 21300000, guid: 2dc25e3625b84aebad4b89eded5e3b66, type: 3}
    title: 4. Seedheart Siege
    copy: Reach the final relay and let Mother Rust hear the Seed.
  restoration:
    art: {fileID: 21300000, guid: 4e1b86398a29a3348997e4ea1999fc80, type: 3}
    title: The first garden wakes
    copy: Water runs through the first relay. Across the roof, the nursery turns
      green. Three gardens are still waiting.
  illustration: {fileID: 2399200035}
  chapter: {fileID: 2399200031}
  title: {fileID: 2399200039}
  copy: {fileID: 2399200043}
  progress: {fileID: 2399200047}
  primaryLabel: {fileID: 2399200056}
  secondaryLabel: {fileID: 2399200065}
  primary: {fileID: 2399200052}
